FROM maven:3.9.6-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
COPY src ./src
RUN mvn clean package -DskipTests

# glibc runtime (not -alpine/musl): Kafka Streams' RocksDB-backed state stores
# (join/aggregation windows) ship a native library linked against glibc and fail
# to load under musl - see plans/here-to-slay-etapa2 risk notes.
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
COPY --from=build /app/target/*-jar-with-dependencies.jar app.jar
ENTRYPOINT ["java", "-cp", "app.jar", "org.br.heretoslay.streams.monitoring.GameMonitoringStreamsProcessor"]
