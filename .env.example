# Copy to .env (git ignores it). Used by docker-compose for local development.
FIREBASE_PROJECT_ID=your-firebase-project-id
DB_PASSWORD=choose-a-local-password

# Client (Vite reads these at build time). They are public by design: Firebase protects
# the project with the authorized domains list, not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=
VITE_ACCOUNTS_API_URL=http://localhost:8080/api/v1
