{
    "appId": "com.jgbarros.heretoslay",
    "productName": "Here to Slay",
    "directories": {
        "output": "release-app"
    },
    "files": [
        "dist/**",
        "dist-electron/**",
        "package.json"
    ],
    "win": {
        "target": ["nsis", "portable"],
        "icon": "public/icon.png"
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "artifactName": "HereToSlay-Setup-${version}.${ext}"
    },
    "portable": {
        "artifactName": "HereToSlay-${version}-portable.${ext}"
    },
    "mac": {
        "target": ["dmg"],
        "icon": "public/icon.png"
    }
}
