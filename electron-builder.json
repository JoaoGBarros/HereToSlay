{
    "appId": "com.jgbarros.heretoslay",
    "productName": "Here to Slay",
    "directories": {
        "output": "release-app"
    },
    "files": [
        "dist/**",
        "dist-electron/**",
        "package.json",
        "!node_modules/**"
    ],
    "win": {
        "target": [
            "portable"
        ],
        "icon": "public/icon.png"
    },
    "portable": {
        "artifactName": "HereToSlay-${version}-portable.${ext}"
    },
    "mac": {
        "target": [
            "dmg"
        ],
        "icon": "public/icon.png"
    }
}
