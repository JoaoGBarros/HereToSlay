# Builds for the web client and the desktop app talk to the public game server.
VITE_BACKEND_WS_URL=wss://hts.joaogbarros.com/ws

# Accounts API (absolute, so the desktop app loaded from disk can reach it too)
VITE_ACCOUNTS_API_URL=https://hts.joaogbarros.com/api/v1
# Firebase web config: public by design, fill in from the Firebase console (Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
